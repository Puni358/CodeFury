{
  "manifest_version": 3,
  "name": "AccessFill - Accessibility Autofill Assistant",
  "version": "1.0.0",
  "description": "Accessibility-focused autofill assistant with multi-layer field matching, language toggles, and consent tooltips for digital forms.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://generativelanguage.googleapis.com/*",
    "https://*.supabase.co/*",
    "https://aviioibehxmkjwnoekjt.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AccessFill"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "fieldMatcher.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
